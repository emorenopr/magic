# Copia este archivo a .env (uso local) y pon tus valores reales.
# En Vercel, agrega estas variables en Project Settings -> Environment
# Variables en vez de subir un .env.
ANTHROPIC_API_KEY=

# Se agregan solas al conectar una base de datos Redis (Storage -> Create
# Database) desde el dashboard de Vercel. No hace falta copiarlas a mano.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contraseña compartida para ver las conversaciones guardadas en /admin.html.
# Elige la tuya - no dejes este valor vacío en producción.
ADMIN_PASSWORD=

# Prospector (opcional): para buscar negocios en Google Maps con
# `npm run prospectar:buscar`. Se crea en Google Cloud -> Places API (New).
GOOGLE_PLACES_API_KEY=

# Agenda personal (/agenda/ y /tv): contraseña para entrar desde el celular,
# la TV y el conector de Claude. Usa una larga y que no uses en otro lado.
AGENDA_PASSWORD=
# Zona horaria para "hoy" y "mañana" cuando Claude anota cosas (opcional).
AGENDA_TZ=America/Puerto_Rico
