# Copia este archivo a .env (uso local) y pon tus valores reales.
# En Vercel, agrega estas variables en Project Settings -> Environment
# Variables en vez de subir un .env.
ANTHROPIC_API_KEY=

# Se agregan solas al conectar una base de datos Redis (Storage -> Create
# Database) desde el dashboard de Vercel. No hace falta copiarlas a mano.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contraseña compartida para ver las conversaciones guardadas en /admin.html.
# Elige la tuya - no dejes este valor vacío en producción.
ADMIN_PASSWORD=

# --- Línea telefónica (api/voice.js) ---
# Auth Token de tu cuenta de Twilio (Console -> Account Info). Se usa para
# verificar que las llamadas al endpoint vienen de Twilio de verdad.
TWILIO_AUTH_TOKEN=

# Número al que se transfiere la llamada cuando el cliente pide hablar con
# una persona (formato +1787XXXXXXX). Si lo dejas vacío, el bot le pide que
# llame más tarde.
HUMAN_TRANSFER_NUMBER=

# Opcional: voz de Twilio para leer las respuestas (por defecto Polly.Lupe-Neural).
TWILIO_VOICE=
